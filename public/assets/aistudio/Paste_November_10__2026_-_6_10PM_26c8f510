<script>
  // Pricing Toggle Logic
  function setBilling(cycle) {
    const bg = document.getElementById('price-toggle-bg');
    const btnMonthly = document.getElementById('btn-monthly');
    const btnYearly = document.getElementById('btn-yearly');
    const prices = document.querySelectorAll('.price-val');
    const periods = document.querySelectorAll('.price-period');

    if (cycle === 'monthly') {
      bg.classList.remove('left-[92px]');
      bg.classList.add('left-1');
      
      btnMonthly.classList.remove('text-text-secondary', 'hover:text-white');
      btnMonthly.classList.add('text-black');
      
      btnYearly.classList.add('text-text-secondary', 'hover:text-white');
      btnYearly.classList.remove('text-black');

      prices.forEach(p => p.textContent = ' + p.dataset.monthly);
      periods.forEach(p => p.textContent = '/mo');
    } else {
      bg.classList.add('left-[92px]');
      bg.classList.remove('left-1');

      btnYearly.classList.remove('text-text-secondary', 'hover:text-white');
      btnYearly.classList.add('text-black');

      btnMonthly.classList.add('text-text-secondary', 'hover:text-white');
      btnMonthly.classList.remove('text-black');

      prices.forEach(p => p.textContent = ' + p.dataset.yearly);
      periods.forEach(p => p.textContent = '/yr');
    }
  }

  // Gallery Scroll Logic
  document.addEventListener('DOMContentLoaded', () => {
    const galleryContainer = document.getElementById('gallery-container');
    const prevBtn = document.getElementById('gallery-prev');
    const nextBtn = document.getElementById('gallery-next');

    if(galleryContainer && prevBtn && nextBtn) {
      prevBtn.addEventListener('click', () => {
        // Scroll width: item width + gap (16px)
        const item = galleryContainer.querySelector('div');
        const scrollAmount = item ? item.offsetWidth + 16 : 300;
        galleryContainer.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
      nextBtn.addEventListener('click', () => {
        const item = galleryContainer.querySelector('div');
        const scrollAmount = item ? item.offsetWidth + 16 : 300;
        galleryContainer.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }
  });
</script></main>

